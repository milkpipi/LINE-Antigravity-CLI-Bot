# 複製成 .env 後填入（.env 不要上傳到任何地方）

# LINE Developers > 你的 Messaging API channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 你自己的 LINE userId（U 開頭）。先留空啟動，傳訊息給 bot 會回傳給你，再填進來重啟。
# 多個用逗號分隔。這份名單決定誰能「私訊」bot。
ALLOWED_USER_IDS=

# 允許運作的群組 groupId（C 開頭），多個用逗號分隔；留空 = 群組功能關閉。
# 取得方式：把 bot 拉進群組，由你（ALLOWED_USER_IDS 裡的人）在群組傳「/id」。
# 白名單群組裡的所有成員都能用 bot。注意：Google 表示個人 AI Pro 額度不適用於多人共用的中繼。
ALLOWED_GROUP_IDS=

# 群組裡的觸發詞（訊息開頭），另外 @bot 也會觸發
GROUP_TRIGGERS=/ai,!ai

# 群組模式：
#   trigger  只有 @bot 或觸發詞才回應，只看那一則（最省額度）
#   context  一樣要 @bot 或觸發詞才回應，但會附上這段期間的群組聊天當上下文（呼叫次數不變）
#   auto     自動讀所有訊息，大家安靜 GROUP_AUTO_DELAY 秒後整批交給模型，由模型決定要不要插話
GROUP_MODE=trigger

# auto 模式：最後一則訊息後等幾秒才送出（同一段聊天合併成一次呼叫）。
# 建議 5~15 秒；太長會讓 reply token 過期而改用 push（push 到群組會依成員數計算訊息則數）
GROUP_AUTO_DELAY=10

# auto 模式：每段聊天有多少機率會回應（0.2 或 20% 都可以）。
# 沒抽中的訊息會保留成上下文；@bot、觸發詞、提到 BOT_NAMES 一律會回。
AUTO_REPLY_CHANCE=0.2

# bot 的名字（逗號分隔），訊息中提到就一定回應，例如：魚魚,小魚
BOT_NAMES=

# auto 模式插話規則（單行，選填）；留空用內建規則。要求不想回時輸出 [SKIP]
# AUTO_NOTE=

# context / auto 模式最多保留幾則群組訊息當上下文
GROUP_CONTEXT_MAX=40

# ---- 語音回覆 ----
# off = 不用語音；model = 模型自己決定（有人說「用講的」「念給我聽」時）；always = 每次都用語音
VOICE_MODE=model

# 語音引擎：gemini（最自然，需要免費 API key + ffmpeg）/ edge（edge-tts）/ http（本機 TTS 伺服器）
VOICE_ENGINE=gemini
# 主引擎失敗時依序改用（逗號分隔）；都失敗就回文字
VOICE_FALLBACK=edge

# Gemini TTS：到 https://aistudio.google.com/apikey 建立免費 API key（跟 Gemini 訂閱分開計算）
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# 聲音：Leda（年輕）、Aoede（輕快）、Achernar（柔和）、Sulafat（溫暖）、Puck（活潑）、Kore（沉穩）…
GEMINI_TTS_VOICE=Leda
# 用文字描述語氣（單行）
GEMINI_TTS_STYLE=台灣年輕女生用 LINE 傳語音給朋友，台灣腔國語，自然口語、輕鬆隨性，語速正常偏快

# edge-tts（備援）：zh-TW-HsiaoChenNeural（女）、zh-TW-HsiaoYuNeural（女）、zh-TW-YunJheNeural（男）
VOICE_NAME=zh-TW-HsiaoChenNeural
VOICE_RATE=+0%
VOICE_PITCH=+0Hz

# 本機 TTS 伺服器（VOICE_ENGINE=http 時），{text} 會被換成要念的內容，例如 GPT-SoVITS：
# VOICE_HTTP_URL=http://127.0.0.1:9880/tts?text={text}&text_lang=zh&ref_audio_path=ref.wav&prompt_text=參考音檔的文字&prompt_lang=zh
VOICE_HTTP_URL=

# 1 = 語音後面再附上文字
VOICE_WITH_TEXT=0
# 超過這個字數就改用文字（避免一段好幾分鐘的語音）
VOICE_MAX_CHARS=200
# 公開網址；留空會從 LINE 的 webhook 自動偵測（trycloudflare 網址會變也沒關係）
PUBLIC_BASE_URL=

# 圖片：私訊傳圖後等幾秒，看你有沒有補一句文字（有就合併成一題）
IMAGE_WAIT=8
# 群組 trigger 模式：圖片傳出後幾秒內有人叫 bot，會把那張圖一起附上
IMAGE_ATTACH_WINDOW=300
# 下載的圖片保留幾小時後自動刪除（存在 agy 工作目錄的 images/ 底下）
IMAGE_KEEP_HOURS=24

# Webhook 監聽埠
PORT=8080

# agy 執行檔路徑；留空會自動從 PATH 找（Windows 會找到 agy.exe）
AGY_BIN=

# 模型 slug，用 `agy models` 查；留空用帳號預設。選 Gemini 系列就不會動到任何 Claude 訂閱。
AGY_MODEL=

# 推理強度（low ~ max，依模型而定）；留空用預設
AGY_EFFORT=

# 1 = 加 --sandbox（終端指令受限）；若你的平台不支援導致報錯，改成 0
AGY_SANDBOX=1

# 單次回覆最長等待時間
AGY_TIMEOUT=5m

# agy 的工作目錄（預設是程式旁邊的 agy_workdir，空資料夾）
AGY_WORKDIR=

# 角色設定：預設讀程式旁邊的 persona.txt（可多行）；要換檔案就改這裡
# PERSONA_FILE=persona.txt
# 沒有 persona.txt 時才會用這行（只能單行）
# PERSONA=你是我的私人助理……
